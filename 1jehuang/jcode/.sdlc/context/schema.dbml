  abandoned_before_response integer [default: 0, note: 'added 0003']
  session_stop_reason text [note: 'added 0008']
  agent_role text [note: 'added 0008; root or child']
  parent_session_id text [note: 'added 0008']
  agent_active_ms_total integer [default: 0, note: 'added 0008']
  agent_model_ms_total integer [default: 0, note: 'added 0008']
  agent_tool_ms_total integer [default: 0, note: 'added 0008']
