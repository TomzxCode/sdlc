Table daily_active_users {
  activity_date text [not null, note: 'UTC date']
  telemetry_id text [not null]
  first_seen_at text [default: `datetime('now')`]
  last_seen_at text [default: `datetime('now')`]
  raw_active integer [default: 0]
  meaningful_active integer [default: 0]
  release_active integer [default: 0]
  meaningful_release_active integer [default: 0]
  session_start_count integer [default: 0]
  turn_end_count integer [default: 0]
  session_end_count integer [default: 0]
  session_crash_count integer [default: 0]
  ci_active integer [default: 0, note: 'added 0012']
  last_is_ci integer [default: 0, note: 'added 0012']
  last_build_channel text
  last_country text [note: 'added 0022; 2-letter country from Cloudflare edge, IP never stored']

  Note: 'Materialized DAU/WAU/MAU rollup, one row per UTC day and telemetry_id (0010). Indexes: idx_daily_active_date, idx_daily_active_date_release (0010), idx_daily_active_date_ci (0012), idx_daily_active_date_country (0022).'
}

Table country_daily {
  activity_date text [not null]
  country text [not null, note: '2-letter code from Cloudflare edge']
  event text [not null]
  is_ci integer [not null, default: 0]
  event_count integer [not null, default: 0]
  first_seen_at text [default: `datetime('now')`]
  last_seen_at text [default: `datetime('now')`]

  Note: 'Coarse geographic aggregate (0022). IP addresses never stored. Indexes: idx_country_daily_date, idx_country_daily_country.'
}

Table model_prices {
  model text [pk, note: 'raw telemetry model label, not a models.dev id']
  source_model text [note: 'canonical models.dev id the price was taken from']
  source_provider text [note: 'models.dev provider id']
  input_usd_per_mtok real [note: 'NULL means unpriced, not free']
  output_usd_per_mtok real [note: 'NULL means unpriced, not free']
  cache_read_usd_per_mtok real [note: 'NULL means unpriced, not free']
  cache_write_usd_per_mtok real [note: 'NULL means unpriced, not free']
  input_includes_cache_read integer [not null, default: 0, note: '1 when provider input count already includes cache reads (OpenAI-style)']
  price_kind text [not null, default: 'catalog', note: 'catalog, free, or unpriced']
  updated_at text [default: `datetime('now')`]

  Note: 'List-price reference synced from models.dev catalog by scripts/sync-model-prices.mjs (0023). Powers token-value dashboard. Index: idx_model_prices_price_kind.'
}

Table web_details {
  event_id text [pk, note: 'web_pageview, web_cta_click, web_vital, or web_error event']
  path text
  referrer text
  visitor_id text [note: 'anonymous website visitor']
  utm_source text
  utm_medium text
  utm_campaign text
  cta text
  metric_name text [note: 'added 0018; web vitals metric']
  metric_value real [note: 'added 0018']
  rating text [note: 'added 0018']
  error_kind text [note: 'added 0018']
  pageview_id text [note: 'added 0020']
  conversion_id text [note: 'added 0020; per-click UUID, nulled after 90 days']
  placement text [note: 'added 0020']
  install_method text [note: 'added 0020']

  Note: 'Website beacon detail rows (0016, extended 0018, 0020). Indexes: idx_web_details_visitor_id, idx_web_details_path, idx_web_details_cta, idx_web_details_conversion_id WHERE NOT NULL (0020), idx_web_details_pageview_id WHERE NOT NULL (0020).'
}

Table install_details {
  event_id text [pk]
  conversion_id text [note: 'opaque per-click UUID, nulled after 90 days']
  stage text
  outcome text
  source text
  placement text
  install_method text
  failure_stage text

  Note: 'Website to installer to first-run conversion attribution (0020). Indexes: idx_install_details_conversion_id WHERE NOT NULL, idx_install_details_stage_outcome.'
}

Table discovery_details {
  event_id text [pk]
  request_id text [not null, unique]
  phase text [not null]
  category text
  selected_tool text
  outcome text [not null]
  failure_reason text
  http_status integer
  latency_ms integer [not null, default: 0]
  response_bytes integer
  result_count integer
  query_present integer [not null, default: 0, note: 'free-text query never sent/stored']
  reason_present integer [not null, default: 0]
  custom_endpoint integer [not null, default: 0]
  benchmark_run integer [not null, default: 0, note: 'added 0019']

  Note: 'Privacy-safe sponsored-discovery attempt details (0017, benchmark flag 0019). Indexes: idx_discovery_request_id UNIQUE, idx_discovery_phase_outcome, idx_discovery_category_outcome, idx_discovery_selected_tool, idx_discovery_failure_reason, idx_discovery_benchmark_run (0019).'
}

Table todo_session_details {
  event_id text [pk]
  correlation_id text [not null, unique, note: 'fresh UUID; parent telemetry_id is ephemeral, rows cannot be joined to accounts']
  session_end_reason text [not null]
  todos_created integer [not null, default: 0]
  todos_completed integer [not null, default: 0]
  todos_abandoned integer [not null, default: 0]
  todo_updates integer [not null, default: 0]
  groups_completed integer [not null, default: 0]
  groups_total integer [not null, default: 0]
  max_todo_list_size integer [not null, default: 0]
  confidence_min integer
  confidence_mean real
  confidence_count integer [not null, default: 0]
  completion_confidence_min integer
  completion_confidence_mean real
  completion_confidence_count integer [not null, default: 0]
  understands_user_intent_min integer
  understands_user_intent_mean real
  understands_user_intent_count integer [not null, default: 0]
  closed_feedback_loop_min integer
  closed_feedback_loop_mean real
  closed_feedback_loop_count integer [not null, default: 0]
  end_to_end_ownership_min integer
  end_to_end_ownership_mean real
  end_to_end_ownership_count integer [not null, default: 0]

  Note: 'One privacy-safe todo aggregate per client runtime session (0024). Indexes: idx_todo_session_completed, idx_todo_session_groups_completed.'
}

Table transcript_uploads {
  upload_id text [pk]
  telemetry_id text [not null]
  object_key text [not null, unique, note: 'R2 TRANSCRIPTS bucket key']
  consent_version integer [not null]
  schema_version integer [not null]
  version text [not null]
  provider text
  model text
  end_reason text [not null]
  message_count integer [not null]
  byte_count integer [not null]
  created_at text [not null, default: `datetime('now')`]

  Note: 'Metadata for separately consented transcript uploads (0025). Bodies in R2, never in D1. Indexes: idx_transcript_uploads_telemetry_id, idx_transcript_uploads_created_at.'
}

Table concurrency_details {
  event_id text [pk, note: 'session_concurrency event']
  concurrency_tracking_version integer
  concurrency_tracking_scope text
  concurrency_tracking_available integer
  concurrency_session_id text
  phase text [note: 'start or end']
  agent_role text [note: 'root or child']
  runtime_is_ci integer
  active_sessions_at_start integer
  other_active_sessions_at_start integer
  max_concurrent_sessions integer
  root_sessions_at_start integer
  child_sessions_at_start integer
  max_concurrent_root_sessions integer
  max_concurrent_child_sessions integer
  multi_sessioned integer
  quality text [not null, note: 'trusted, missing_version, legacy_version, unsupported_version, legacy_scope, missing_fields, invalid, unavailable']
  quality_reason text [not null]
  raw_json text [not null]

  Note: 'Reliable runtime concurrency, additive only with no backfill of legacy rows (0026). Separate table keeps events below D1 column cap. Backed by views concurrency_event_quality (trusted revalidation over session_concurrency, session_start, session_end, session_crash) and trusted_concurrency_events (trusted non-CI session_concurrency only).'
}

