// .sdlc/context/schema.dbml
// Generated by /sync-sdlc on 2026-09-20.
// Source: telemetry-worker/schema.sql (consolidated) + telemetry-worker/migrations/0001..0026.
// Database: Cloudflare D1 (SQLite). No ORM, raw SQL only. Access via telemetry-worker.
// Analytics fact-table design: events is the wide central fact table (near D1's
// 100-column cap); per-domain detail tables key off events.event_id. There are no
// enforced foreign keys between analytics rows and users/accounts (telemetry_id is
// an anonymous client identifier, account_id is only set on subscription events).
// NOTE (non-relational, not modeled below): local CLI sessions are stored as
// JSON/JSONL documents under ~/.jcode/sessions, not in D1. Transcript bodies live
// in the private R2 TRANSCRIPTS bucket; only transcript_uploads metadata is in D1.
// Views concurrency_event_quality and trusted_concurrency_events (migration 0026)
// exist in D1 but are not modeled as tables; see concurrency_details Note.

Table events {
  id integer [pk, increment]
  telemetry_id text [not null, note: 'anonymous client install id']
  event text [not null, note: 'session_start, session_end, turn_end, onboarding_step, subscription_*, web_*, install_*, discovery_*, session_concurrency, ...']
  version text [not null]
  os text [not null]
  arch text [not null]
  provider_start text
  provider_end text
  model_start text
  model_end text
  provider_switches integer [default: 0]
  model_switches integer [default: 0]
  duration_mins integer
  duration_secs integer [note: 'added 0003']
  turns integer
  had_user_prompt integer [default: 0, note: 'added 0001']
  had_assistant_response integer [default: 0, note: 'added 0001']
  assistant_responses integer [default: 0, note: 'added 0001']
  first_assistant_response_ms integer [note: 'added 0003']
  first_tool_call_ms integer [note: 'added 0003']
  first_tool_success_ms integer [note: 'added 0003']
  tool_calls integer [default: 0, note: 'added 0001']
  tool_failures integer [default: 0, note: 'added 0001']
  executed_tool_calls integer [default: 0, note: 'added 0003']
  executed_tool_successes integer [default: 0, note: 'added 0003']
  executed_tool_failures integer [default: 0, note: 'added 0003']
  tool_latency_total_ms integer [default: 0, note: 'added 0003']
  tool_latency_max_ms integer [default: 0, note: 'added 0003']
  file_write_calls integer [default: 0, note: 'added 0003']
  tests_run integer [default: 0, note: 'added 0003']
  tests_passed integer [default: 0, note: 'added 0003']
  input_tokens integer [default: 0, note: 'added 0006']
  output_tokens integer [default: 0, note: 'added 0006']
  cache_read_input_tokens integer [default: 0, note: 'added 0006']
  cache_creation_input_tokens integer [default: 0, note: 'added 0006']
  total_tokens integer [default: 0, note: 'added 0006']
  feature_memory_used integer [default: 0, note: 'added 0003']
  feature_swarm_used integer [default: 0, note: 'added 0003']
  feature_web_used integer [default: 0, note: 'added 0003']
  feature_email_used integer [default: 0, note: 'added 0003']
