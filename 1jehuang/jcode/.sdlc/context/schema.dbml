  time_to_first_useful_action_ms integer [note: 'added 0008']
  spawned_agent_count integer [default: 0, note: 'added 0008']
  background_task_count integer [default: 0, note: 'added 0008']
  background_task_completed_count integer [default: 0, note: 'added 0008']
  subagent_task_count integer [default: 0, note: 'added 0008']
  subagent_success_count integer [default: 0, note: 'added 0008']
  swarm_task_count integer [default: 0, note: 'added 0008']
  swarm_success_count integer [default: 0, note: 'added 0008']
  user_cancelled_count integer [default: 0, note: 'added 0008']
  transport_https integer [default: 0, note: 'added 0002']
  transport_persistent_ws_fresh integer [default: 0, note: 'added 0002']
  transport_persistent_ws_reuse integer [default: 0, note: 'added 0002']
  transport_cli_subprocess integer [default: 0, note: 'added 0002']
  transport_native_http2 integer [default: 0, note: 'added 0002']
  transport_other integer [default: 0, note: 'added 0002']
  resumed_session integer [default: 0, note: 'added 0001']
  end_reason text
  auth_provider text [note: 'added 0003']
  auth_method text [note: 'added 0003']
  auth_failure_reason text [note: 'added 0015; classify_auth_failure_message label on auth_failed onboarding_step']
  from_version text [note: 'added 0003']
  event_id text [unique, note: 'client-generated dedup key, added 0004']
  session_id text [note: 'added 0004']
  schema_version integer [default: 1, note: 'added 0004']
  build_channel text [note: 'added 0004']
  is_git_checkout integer [default: 0, note: 'added 0004']
  is_ci integer [default: 0, note: 'added 0004']
  ran_from_cargo integer [default: 0, note: 'added 0004']
  step text [note: 'added 0004; onboarding funnel step']
  milestone_elapsed_ms integer [note: 'added 0004']
  feedback_rating text [note: 'added 0004']
  feedback_reason text [note: 'added 0004']
  feedback_text text [note: 'added 0009']
  error_provider_timeout integer [default: 0]
  error_auth_failed integer [default: 0]
  error_tool_error integer [default: 0]
  error_mcp_error integer [default: 0]
  error_rate_limited integer [default: 0]
  account_id text [note: 'added 0016; only subscription/account_linked events']
  tier text [note: 'added 0016; subscription tier']
  created_at text [default: `datetime('now')`]

  Note: 'Central analytics fact table. ~100 wide columns at D1 column cap; new per-event fields go in detail tables, not here. Indexes: idx_events_telemetry_id, idx_events_event, idx_events_created_at, idx_events_event_created_telemetry (0007), idx_events_event_telemetry_created (0007), idx_events_event_id UNIQUE, idx_events_session_id, idx_events_step, idx_events_feedback_rating, idx_events_account_id (0016), idx_events_event_tier_created (0016). Migrations also add idx_events_session_stop_reason, idx_events_agent_role (0008), idx_events_turn_index, idx_events_session_start_hour_utc, idx_events_multi_sessioned (0005).'
}

