  model TEXT [not null]
  provider_key TEXT [not null]
  hash TEXT [not null]
  embedding BLOB [not null]
  dims INTEGER
  updated_at INTEGER [not null]
  Indexes {
    (provider, model, provider_key, hash) [pk]
    (updated_at)
  }
}

Table memory_index_state {
  id INTEGER [pk, not null]
  revision INTEGER [not null]
}

Table standing_intents {
  intent_key INTEGER [pk, not null]
  id TEXT [not null, unique]
  description TEXT [not null]
  trigger_keywords TEXT [not null]
  trigger_embedding TEXT
  channel_scope TEXT
  sender_scope TEXT
  creator_sender TEXT
  status TEXT [not null]
  expires_at INTEGER [not null]
  max_fires INTEGER [not null]
  fire_count INTEGER [not null, default: `0`]
  cooldown_seconds INTEGER [not null, default: `86400`]
  last_fired_at INTEGER
  created_at INTEGER [not null]
  source_session_id TEXT
  Indexes {
    (status, expires_at, last_fired_at)
    (status, channel_scope, sender_scope)
  }
}

Table session_transcript_index_state {
  session_id TEXT [pk, not null]
  indexed_seq INTEGER [not null]
  leaf_event_id TEXT
  needs_rebuild INTEGER [not null, default: `0`]
  active_event_count INTEGER [not null, default: `0`]
  active_message_count INTEGER [not null, default: `0`]
  updated_at INTEGER [not null]
}

Table session_transcript_active_events {
  session_id TEXT [not null]
  active_position INTEGER [not null]
  event_seq INTEGER [not null]
  message_position INTEGER
  context_eligible INTEGER
  Indexes {
    (session_id, active_position) [pk]
    (session_id, event_seq) [unique]
    (session_id, message_position) [unique]
    (session_id)
  }
}

Table session_transcript_fts_rows {
  id INTEGER [pk, not null]
  session_id TEXT [not null]
  message_id TEXT
