// Generated by /sync-sdlc on 2026-10-19.
// Source: packages/durable/src/storage/sqlite/migrations.ts (migrations 1 and 2), packages/durable/src/storage/sqlite/schema.ts (table and index names), packages/chord/src/sqlite/migrations.ts (the migration-runner table).
// This is the only SQL schema in the repo: the pi-durable SQLite store.
// Every table is STRICT, and every JSON column carries CHECK (json_valid(...)).
// Indexed string identities (documents.kind, documents.key_value, submissions.request_id, tasks.kind) are stored JSON-encoded so lone UTF-16 surrogates survive.
// The Ref relationships below are logical only: the schema declares no SQL foreign keys, and the storage layer enforces every relationship.
// Other persistence in the project is not SQL: MemoryStorage (packages/durable/src/storage/memory.ts), JsonlStorage (packages/durable/src/storage/jsonl/, FORMAT_VERSION = 1), and the coding agent's JSONL session files.

// durable_schema is created by the chord migration runner, not by a durable migration.
Table durable_schema {
  singleton integer [PK, note: 'Always 1, migration bookkeeping']
  version integer [NOT NULL, note: 'Applied migration version, >= 0']
}

// durable_metadata is seeded by migration 1 with next_id = '2' and next_seq = 1.
Table durable_metadata {
  singleton integer [PK, note: 'Always 1']
  next_id text [NOT NULL, note: 'Next ID counter, TEXT because node:sqlite rejects INTEGER results outside the safe integer range']
  next_seq integer [NOT NULL, note: 'Next commit seq counter']
}

// record_ids is the global ID ownership table: an id belongs to one record type across every table.
Table record_ids {
  id integer [PK, note: 'Global ID registry across record types']
  record_type text [NOT NULL, note: "'conversation' | 'entry' | 'task' | 'submission' | 'document'"]
}

Table conversations {
  id integer [PK]
  owner_conversation_id integer [note: 'Nullable owner conversation id']
  owner_task_id integer [note: 'Nullable owner task id']
  record text [NOT NULL, note: 'JSON ConversationRecord']

  Indexes {
    (owner_conversation_id, id) [name: 'conversations_by_owner_conversation']
    (owner_task_id, id) [name: 'conversations_by_owner_task']
  }
}

Table entries {
  id integer [PK]
  conversation_id integer [NOT NULL]
  head integer [note: 'Nullable head marker id, the lower bound of the active range']
  commit_seq integer [NOT NULL, note: 'Commit seq that wrote the entry']
  record text [NOT NULL, note: 'JSON EntryRecord']

  Indexes {
    (conversation_id, id) [name: 'entries_by_conversation', note: 'id DESC']
    (conversation_id, id) [name: 'entry_heads_by_conversation', note: 'Partial index WHERE head IS NOT NULL, id DESC']
  }
}

// tasks.status gained the sleeping value in migration 2, which rebuilt the table because SQLite cannot alter a CHECK constraint in place.
Table tasks {
  id integer [PK]
  conversation_id integer [NOT NULL]
  kind text [NOT NULL, note: 'JSON-encoded task kind']
  status text [NOT NULL, note: "'pending' | 'running' | 'waiting' | 'sleeping' | 'completing' | 'terminal'"]
  abort_requested integer [NOT NULL, note: 'Boolean 0/1']
  background integer [NOT NULL, note: 'Boolean 0/1']
  record text [NOT NULL, note: 'JSON TaskRecord']

  Indexes {
    (status, id) [name: 'tasks_by_status']
    (conversation_id, id) [name: 'tasks_by_conversation']
    (kind, id) [name: 'tasks_by_kind']
    (abort_requested, id) [name: 'tasks_by_abort_requested']
    (background, id) [name: 'tasks_by_background']
  }
}

Table submissions {
  id integer [PK]
  conversation_id integer [NOT NULL]
  request_id text [note: 'Nullable host-supplied dedup key, JSON-encoded when present']
  status text [NOT NULL, note: "'queued' | 'placed' | 'done' | 'unanswered'"]
  record text [NOT NULL, note: 'JSON SubmissionRecord']

  Indexes {
    (conversation_id, request_id) [name: 'submissions_by_request']
    (conversation_id, id) [name: 'submissions_by_conversation']
    (status, id) [name: 'submissions_by_status']
  }
}

// A document is addressed by (kind, scope_kind, owner_id, family, key_value).
Table documents {
  id integer [PK]
  kind text [NOT NULL, note: 'JSON-encoded document kind']
  family integer [NOT NULL, note: 'Boolean 0/1, 1 when the document has a key']
  key_value text [NOT NULL, note: 'JSON-encoded key, empty when family is 0']
  scope_kind text [NOT NULL, note: "'session' | 'conversation' | 'task'"]
  owner_id integer [NOT NULL, note: '0 for session scope, else the conversation or task id']
  created_at integer [NOT NULL, note: 'Commit seq of creation']
  retired_at integer [note: 'Nullable commit seq of retirement']
  record text [NOT NULL, note: 'JSON DocumentRecord']

  Indexes {
    (kind, scope_kind, owner_id, family, key_value, created_at, retired_at) [name: 'documents_by_address', note: 'created_at DESC']
    (scope_kind, owner_id, id) [name: 'documents_by_scope']
    (scope_kind, owner_id, kind, id) [name: 'documents_by_scope_kind']
  }
}

Table document_revisions {
  document_id integer [NOT NULL]
  seq integer [NOT NULL, note: 'Commit seq of revision']
  kind text [NOT NULL, note: "'base' | 'delta'"]
  version integer [NOT NULL, note: 'Document definition version']
  content text [NOT NULL, note: 'JSON base value or JSON delta ops']

  Indexes {
    (document_id, seq) [pk]
    (document_id, kind, seq) [name: 'document_revisions_by_kind', note: 'seq DESC']
  }
}

// Logical relationships only, enforced by the storage layer rather than by SQL foreign keys.
Ref: document_revisions.document_id > documents.id
Ref: entries.conversation_id > conversations.id
Ref: entries.head > entries.id
Ref: tasks.conversation_id > conversations.id
Ref: submissions.conversation_id > conversations.id
Ref: conversations.owner_conversation_id > conversations.id
Ref: conversations.owner_task_id > tasks.id
Ref: record_ids.id - conversations.id
Ref: record_ids.id - entries.id
Ref: record_ids.id - tasks.id
Ref: record_ids.id - submissions.id
Ref: record_ids.id - documents.id
