  created_at text [not null]
  updated_at text [not null]
  indexes {
    (status, updated_at, id) [name: 'idxCeSessionsStatusUpdated']
    (stage, created_at, id) [name: 'idxCeSessionsStageCreated']
    (project_id, updated_at, id) [name: 'idxCeSessionsProject']
  }
}

