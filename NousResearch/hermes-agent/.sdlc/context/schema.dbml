// Generated by /sync-sdlc on 2026-09-20 from the three SCHEMA_SQL blocks.
// Sources are hermes_state_common.py, hermes_cli/kanban_db.py, hermes_cli/projects_db.py.
// These are local per-profile embedded SQLite files (not a shared server DB).
// State store lives at $HERMES_HOME/state.db.
// Kanban store lives at $HERMES_HOME/kanban.db.
// Projects store lives at $HERMES_HOME/projects.db.
// Column types mirror the DDL verbatim.
// Indexes mirror CREATE INDEX statements in each SCHEMA_SQL block.
// FTS5 virtual tables are external-content indexes over messages.

// State store tables.

Table schema_version {
  version integer [not null]
}

Table system_prompts {
  hash text [pk]
  prompt text [not null]
}

Table sessions {
  id text [pk]
  source text [not null]
  user_id text
  session_key text
  chat_id text
  chat_type text
  thread_id text
  display_name text
  origin_json text
  expiry_finalized integer [default: 0]
  model text
  model_config text
  system_prompt text
  system_prompt_hash text
  parent_session_id text
  started_at float [not null]
  ended_at float
  end_reason text
  message_count integer [default: 0]
  tool_call_count integer [default: 0]
  input_tokens integer [default: 0]
  output_tokens integer [default: 0]
  cache_read_tokens integer [default: 0]
  cache_write_tokens integer [default: 0]
  reasoning_tokens integer [default: 0]
  cwd text
  git_branch text
  git_repo_root text
  git_metadata_generation integer [not null, default: 0]
  billing_provider text
  billing_base_url text
  billing_mode text
  estimated_cost_usd float
  actual_cost_usd float
  cost_status text
  cost_source text
  pricing_version text
  title text
  title_source text
  last_activity_at float
  last_activity_description text
  last_activity_provenance text
  api_call_count integer [default: 0]
  handoff_state text
  handoff_platform text
  handoff_error text
  compression_failure_cooldown_until float
  compression_failure_error text
  compression_fallback_streak integer [not null, default: 0]
  compression_ineffective_count integer [not null, default: 0]
  compression_recovery_deadline float
  profile_name text
  transport_profile text
  rewind_count integer [not null, default: 0]
  archived integer [not null, default: 0]
  pinned integer [not null, default: 0]
  hidden integer [not null, default: 0]
  last_read_at float
  tool_names text

  indexes {
    (source) [name: 'idx_sessions_source']
    (source, id) [name: 'idx_sessions_source_id']
    (parent_session_id) [name: 'idx_sessions_parent']
    (system_prompt_hash) [name: 'idx_sessions_system_prompt_hash']
    (session_key, started_at) [name: 'idx_sessions_session_key']
    (handoff_state, started_at) [name: 'idx_sessions_handoff_state']
  }
}

Table messages {
  id integer [pk, increment]
  session_id text [not null]
  role text [not null]
  content text
  tool_call_id text
  tool_calls text
  tool_name text
  effect_disposition text
  timestamp float [not null]
  token_count integer
  finish_reason text
  reasoning text
  reasoning_content text
  reasoning_details text
  codex_reasoning_items text
  codex_message_items text
  platform_message_id text
  observed integer [default: 0]
  _compressed_summary integer [not null, default: 0]
  active integer [not null, default: 1]
  compacted integer [not null, default: 0]
  api_content text
  display_kind text
  display_metadata text
  display_identity blob
  display_order integer

  indexes {
    (session_id, timestamp) [name: 'idx_messages_session']
    (session_id, id) [name: 'idx_messages_session_id']
    (session_id) [name: 'idx_messages_assistant_calls_by_session']
    (session_id, active, timestamp) [name: 'idx_messages_session_active']
  }
}

Table session_model_usage {
  session_id text [not null]
  model text [not null]
  billing_provider text [not null, default: '']
  billing_base_url text [not null, default: '']
  billing_mode text [not null, default: '']
  task text [not null, default: '']
  api_call_count integer [not null, default: 0]
  input_tokens integer [not null, default: 0]
  output_tokens integer [not null, default: 0]
  cache_read_tokens integer [not null, default: 0]
  cache_write_tokens integer [not null, default: 0]
  reasoning_tokens integer [not null, default: 0]
  estimated_cost_usd float [not null, default: 0]
  actual_cost_usd float [not null, default: 0]
  cost_status text
  cost_source text
  first_seen float
  last_seen float

  indexes {
    (session_id, model, billing_provider, billing_base_url, billing_mode, task) [pk]
    (session_id) [name: 'idx_session_model_usage_session']
    (model) [name: 'idx_session_model_usage_model']
  }
}

Table state_meta {
  key text [pk]
  value text
}

Table gateway_routing {
  scope text [not null, default: '']
  session_key text [not null]
  entry_json text [not null]
  updated_at float [not null]

  indexes {
    (scope, session_key) [pk]
  }
}

Table gateway_hygiene_state {
  session_key text [pk]
  failure_streak integer [not null, default: 0]
}

Table conversation_generations {
  source text [not null]
  session_key text [not null]
  generation integer [not null, default: 0]

  indexes {
    (source, session_key) [pk]
  }
}

Table gateway_heartbeats {
  backend_id text [pk]
  pid integer [not null]
  started_at float [not null]
  last_heartbeat float [not null]
  profile text [not null, default: '']
  host text [not null, default: '']
}

Table compression_locks {
  session_id text [pk]
  holder text [not null]
  acquired_at float [not null]
  expires_at float [not null]

  indexes {
    (expires_at) [name: 'idx_compression_locks_expires']
  }
}

Table session_turn_leases {
  conversation_id text [pk]
  holder text [not null]
  acquired_at float [not null]
  expires_at float [not null]

  indexes {
    (expires_at) [name: 'idx_session_turn_leases_expires']
  }
}

Table async_delegations {
  delegation_id text [pk]
  origin_session text [not null]
  origin_ui_session_id text [not null, default: '']
  parent_session_id text
  state text [not null]
  dispatched_at float [not null]
  completed_at float
  updated_at float [not null]
  event_json text
  result_json text
  delivery_state text [not null, default: 'pending']
  delivery_attempts integer [not null, default: 0]
  delivered_at float
  owner_pid integer
  owner_started_at integer
  task_json text
  delivery_claim text
  delivery_claimed_at float
  origin_session_id text [not null, default: '']

  indexes {
    (delivery_state, completed_at) [name: 'idx_async_delegations_delivery']
  }
}

// FTS5 external-content index over messages_fts_src view.
// Columns are content, tool_name, tool_calls.
// Content rowid is messages.id.
Table messages_fts {
  rowid integer [pk]
  content text
  tool_name text
  tool_calls text
}

// Trigram FTS5 index over messages_fts_trigram_src view.
// Excludes role tool rows and cron/subagent sessions.
// Columns are content, tool_name.
// Content rowid is messages.id.
Table messages_fts_trigram {
  rowid integer [pk]
  content text
  tool_name text
}

// Kanban store tables.

Table tasks {
  id text [pk]
  title text [not null]
  body text
  assignee text
  status text [not null]
  priority integer [default: 0]
  created_by text
  created_at integer [not null]
  started_at integer
  completed_at integer
  workspace_kind text [not null, default: 'scratch']
  workspace_path text
  branch_name text
  project_id text
  claim_lock text
  claim_expires integer
  tenant text
  result text
  idempotency_key text
  consecutive_failures integer [not null, default: 0]
  worker_pid integer
  worker_started_at integer
  last_failure_error text
  max_runtime_seconds integer
  last_heartbeat_at integer
  current_run_id integer
  workflow_template_id text
  current_step_key text
  skills text
  model_override text
  provider_override text
  reasoning_effort text
  max_retries integer
  goal_mode integer [not null, default: 0]
  goal_max_turns integer
  session_id text
  block_kind text
  block_recurrences integer [not null, default: 0]

  indexes {
    (status) [name: 'idx_tasks_status']
  }
}

Table task_links {
  parent_id text [not null]
  child_id text [not null]

  indexes {
    (parent_id, child_id) [pk]
    (child_id) [name: 'idx_links_child']
    (parent_id) [name: 'idx_links_parent']
  }
}

Table task_comments {
  id integer [pk, increment]
  task_id text [not null]
  author text [not null]
  body text [not null]
  created_at integer [not null]

  indexes {
    (task_id, created_at) [name: 'idx_comments_task']
  }
}

Table task_events {
  id integer [pk, increment]
  task_id text [not null]
  run_id integer
  kind text [not null]
  payload text
  created_at integer [not null]

  indexes {
    (task_id, created_at) [name: 'idx_events_task']
  }
}

Table task_runs {
  id integer [pk, increment]
  task_id text [not null]
  profile text
  step_key text
  status text [not null]
  claim_lock text
  claim_expires integer
  worker_pid integer
  worker_started_at integer
  max_runtime_seconds integer
  last_heartbeat_at integer
  started_at integer [not null]
  ended_at integer
  outcome text
  summary text
  metadata text
  error text

  indexes {
    (task_id, started_at) [name: 'idx_runs_task']
    (status) [name: 'idx_runs_status']
  }
}

Table task_attachments {
  id integer [pk, increment]
  task_id text [not null]
  filename text [not null]
  stored_path text [not null]
  content_type text
  size integer [not null, default: 0]
  uploaded_by text
  created_at integer [not null]

  indexes {
    (task_id, created_at) [name: 'idx_attachments_task']
  }
}

Table kanban_notify_subs {
  task_id text [not null]
  platform text [not null]
  chat_id text [not null]
  thread_id text [not null, default: '']
  user_id text
  user_id_alt text
  chat_type text
  notifier_profile text
  delivery_mode text [not null, default: 'notify']
  delivery_metadata text
  created_at integer [not null]
  last_event_id integer [not null, default: 0]
  last_ping_event_id integer [not null, default: 0]

  indexes {
    (task_id, platform, chat_id, thread_id) [pk]
    (task_id) [name: 'idx_notify_task']
  }
}

// Projects store tables.

Table projects {
  id text [pk]
  slug text [not null, unique]
  name text [not null]
  description text
  icon text
  color text
  board_slug text
  primary_path text
  created_at integer [not null]
  archived integer [not null, default: 0]
}

Table project_folders {
  project_id text [not null]
  path text [not null]
  label text
  is_primary integer [not null, default: 0]
  added_at integer [not null]

  indexes {
    (project_id, path) [pk]
    (path) [name: 'idx_project_folders_path']
  }
}

Table project_meta {
  key text [pk]
  value text
}

Table discovered_repos {
  root text [pk]
  label text
  last_seen integer [not null]
}

Ref sessions_parent {
  sessions.parent_session_id > sessions.id
}

Ref sessions_system_prompt {
  sessions.system_prompt_hash > system_prompts.hash
}

Ref messages_session {
  messages.session_id > sessions.id
}

Ref model_usage_session {
  session_model_usage.session_id > sessions.id
}

Ref task_run_task {
  task_runs.task_id > tasks.id
}

Ref task_event_task {
  task_events.task_id > tasks.id
}

Ref task_comment_task {
  task_comments.task_id > tasks.id
}

Ref task_attachment_task {
  task_attachments.task_id > tasks.id
}

Ref task_link_parent {
  task_links.parent_id > tasks.id
}

Ref task_link_child {
  task_links.child_id > tasks.id
}

Ref notify_sub_task {
  kanban_notify_subs.task_id > tasks.id
}

Ref project_folder_project {
  project_folders.project_id > projects.id
}
