// ── Relationships ──
Ref account_user_id_fk {
  account.user_id > user.id [delete: cascade]
}
Ref: activity_log.agent_id > agents.id
Ref: activity_log.company_id > companies.id
Ref: activity_log.run_id > heartbeat_runs.id
Ref adapter_auth_sessions_company_id_fk {
