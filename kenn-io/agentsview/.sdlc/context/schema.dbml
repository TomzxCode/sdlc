    (session_id, message_ordinal, call_index, agent_id) [pk]
  }

  Note: 'Machine-local incremental summary state, never mirrored to PostgreSQL or DuckDB.'
}

Table parser_checkpoints {
  session_id text [pk]
  agent text [not null]
  file_path text [not null]
  file_inode integer [not null]
  file_device integer [not null]
  file_mtime integer [not null]
  file_change_time integer [not null]
  offset integer [not null]
  tail_anchor_digest text [not null]
  hash text [not null]
  next_ordinal integer [not null]
  checkpoint_version integer [not null]
  updated_at text [not null]

  Note: 'SQLite-only parse checkpoints, never mirrored to PostgreSQL or DuckDB.'
}

Table parser_checkpoint_blobs {
  session_id text [pk]
  cursor blob [not null]
  hash_state blob
}

Table session_signal_state {
  session_id text [pk]
  state blob [not null]
  transcript_revision text [not null]
  signal_version integer [not null]
  updated_at text [not null]

  Note: 'Machine-local signal and secret maintenance state, never mirrored to PostgreSQL or DuckDB.'
}

Table messages_cjk_fts_pending_sessions {
  session_id text [pk]
  generation integer [not null]

  Note: 'Created by schemaCJKFTSPendingSessions in internal/db/cjk_fts_runtime.go for the optional simple/cppjieba sidecar.'
}

Table messages_fts {
  content text

  Note: 'FTS5 virtual table over messages(content) with porter unicode61 tokenizer, content_rowid id, maintained by insert and update triggers in internal/db/db.go.'
}

Table messages_cjk_fts {
  content text

  Note: 'FTS5 virtual table over messages(content) with the simple tokenizer, populated only when the optional CJK sidecar extension is loaded.'
}

Table recall_entries_fts {
  title text
  body text
  trigger text

  Note: 'FTS5 virtual table over recall_entries with porter unicode61 tokenizer, maintained by triggers in internal/db/db.go.'
}

Table recall_evidence_fts {
  snippet text

  Note: 'FTS5 virtual table over recall_evidence with porter unicode61 tokenizer, maintained by triggers in internal/db/db.go.'
}

