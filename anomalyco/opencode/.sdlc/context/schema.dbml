// Desktop storage database: packages/desktop/src/main/storage.

// document stores prompt drafts and history under a storage-qualified key.
Table desktop.document {
  key text [pk]
  value text [not null]
}

// blob stores images and text chunks referenced from documents by content hash.
Table desktop.blob {
  id text [pk]
  data blob [not null]
  touched_at integer [not null, default: 0]
}

// state holds values written through platform.storage namespaces.
Table desktop.state {
  name text [not null]
  key text [not null]
  value text [not null]
  updated_at integer [not null]

  Indexes {
    (name, key) [pk]
  }
}

// plugin stores GUI plugin enable state. A read-only extension view exposes four of its columns for downgraded clients.
Table desktop.plugin {
  id text [pk]
  enabled integer [not null, default: true]
  manifest text
  revision text
}

