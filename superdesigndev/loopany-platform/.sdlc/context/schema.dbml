// Loopany database schema (DBML)
// Generated by /sync-sdlc on 2026-09-20.
// Source of truth: packages/server/src/db/schema.ts + packages/server/src/db/auth-schema.ts
// (drizzle.config.ts schema: ["./src/db/schema.ts", "./src/db/auth-schema.ts"], dialect postgresql, out ./drizzle).
// Migrations consulted: drizzle/0000_round_marauders.sql, drizzle/0001_naive_silver_fox.sql, drizzle/0002_funny_sage.sql.
// Notes:
// - Business timestamps are ISO-string text columns (no db-side defaults); auth tables use timestamp with defaultNow().
// - Drizzle text(col, { enum }) is TS-only: NO Postgres CHECK constraint. Enum value changes need no migration.
// - Only session.user_id and account.user_id carry DB-level FOREIGN KEYs (ON DELETE CASCADE).
//   All other cross-table links (loops.machine_id, runs.loop_id, artifact_files.hash, etc.) are LOGICAL only,
//   enforced in application code (store/gateway), not in DDL. Refs below marked [logical] vs [enforced].
// - Blob BYTES live in R2/in-memory blob store keyed by sha256, never in the DB; blobs/artifact_files hold metadata only.

Table machines {
  id text [pk, note: 'm-sha256(deviceToken)[:16]']
  user_id text [not null, note: 'owning user (Better Auth user.id)']
  team_id text [note: 'owning team, backfilled as team-<userId> for pre-team rows']
  name text [not null, note: 'empty string = pending/unnamed']
  hostname text
  platform text
  arch text
  daemon_version text [note: 'null for older daemons']
  token_hash text [not null]
  token text [note: 'plaintext, re-showable from UI (MVP convenience)']
  roots jsonb [note: 'string[] workdir allowlist, null/[] = unrestricted']
  last_seen text
  online boolean [not null, default: false]
  created_at text [not null]

  Indexes {
    user_id [name: 'machines_user_idx']
    team_id [name: 'machines_team_idx']
  }
}

Table loops {
  id text [pk]
  user_id text [not null]
  team_id text
  channel_id text [note: 'notification_channels.id, null = dashboard only']
  machine_id text [not null, note: 'logical -> machines.id']
  name text
  cron text [not null]
  timezone text [note: 'IANA tz, null = server local (UTC in prod)']
  workdir text
  task_file text [note: 'no task column; standing brief lives in task file ## Spec']
  task_file_content text
  task_file_synced_at text
  workflow text [note: 'async function body, zero-LLM pre-filter JS']
  ui text [note: 'generative-UI template']
  state_schema jsonb [note: 'StateField[]']
  notify text [not null, default: 'auto', note: "enum TS-only: always|auto|never"]
  allow_control boolean [not null, default: true]
  goal text [note: 'null = OPEN loop; non-null = CLOSED loop']
  completed_at text [note: 'invariant: non-null implies goal non-null']
  completion_reason text
  model text
  agent text [not null, default: 'claude-code', note: 'TS-only enum from CODING_AGENTS']
  enabled boolean [not null, default: true]
  next_run_at text [note: 'one-shot override; writable edit key is runAt']
  state jsonb
  evolved_run_count integer
  evolve_due boolean
  edit_request text
  created_at text [not null]
  updated_at text [not null]

  Indexes {
    user_id [name: 'loops_user_idx']
    team_id [name: 'loops_team_idx']
    machine_id [name: 'loops_machine_idx']
  }
}

Table runs {
  id text [pk]
  loop_id text [not null, note: 'logical -> loops.id']
  user_id text [not null]
  machine_id text [not null, note: 'logical -> machines.id']
  phase text [not null, note: 'TS-only enum: pending|running|done|error|canceled']
  role text [not null, note: 'TS-only enum: exec|evolve|edit']
  ts text [not null]
  outcome text [note: 'TS-only enum: silent|direct|exec|error|evolve|skipped']
  status text [note: 'TS-only enum: new|resolved|nothing-new']
  message text
  duration_ms integer
  error text
  state jsonb [note: 'Record<string, number|string> observation snapshot']
  control jsonb [note: 'ControlAction[] audit']
  session_id text
  cost_usd double_precision [note: 'doublePrecision; per-loop totals are one SUM']
  usage jsonb [note: 'RunUsage incl. attempts when > 1']
  artifacts jsonb [note: 'RunArtifact[]']
  transcript jsonb [note: 'TranscriptStep[]']
  progress jsonb [note: '{step,label,at?} live heartbeat, cleared on finalize']

  Indexes {
    loop_id [name: 'runs_loop_idx']
    phase [name: 'runs_phase_idx']
    (loop_id, ts) [name: 'runs_loop_ts_idx']
  }
}

Table run_leases {
  token_hash text [pk, note: 'sha256 hex of wire token (rk_... or pre-Batch-6 bare UUID)']
  run_id text [not null]
  loop_id text [not null]
  machine_id text [not null]
  role text [not null, note: 'TS-only enum: exec|evolve|edit']
  allow_control boolean [not null, default: false]
  can_set_ui boolean [not null, default: false]
  can_set_schema boolean [not null, default: false]
  can_set_workflow boolean [not null, default: false]
  can_finish boolean [not null, default: false]
  state text [not null, default: 'active', note: 'TS-only enum: active|terminal-grace']
  expires_at text [note: 'null while active (=Infinity); ISO once terminalized (24h grace)']
  created_at text [not null]

  Indexes {
    run_id [name: 'run_leases_run_idx']
    loop_id [name: 'run_leases_loop_idx']
  }
}

Table connect_keys {
  machine_id text [pk, note: 'm-sha256(connectKey)[:16]; key itself never stored']
  user_id text [not null, note: 'minting user']
  team_id text [note: 'validated active team at mint; null = pre-created-machine path']
  minted_at text [not null, note: 'drives 24h TTL (lazy on read + pruned on write)']
}

Table teams {
  id text [pk]
  name text [not null]
  owner_user_id text [note: 'null for open-mode shared team']
  created_at text [not null]
}

Table team_members {
  id text [pk]
  team_id text [not null]
  user_id text [not null]
  role text [not null, default: 'member', note: 'TS-only enum: owner|member']
  created_at text [not null]

  Indexes {
    team_id [name: 'team_members_team_idx']
    user_id [name: 'team_members_user_idx']
  }
}

Table team_invites {
  token text [pk, note: 'wire token in /invite/<token>; plaintext, single-use']
  team_id text [not null]
  role text [not null, default: 'member', note: 'TS-only enum: owner|member, capped at inviter role']
  invited_by_user_id text [not null]
  expires_at text [not null, note: '7-day TTL']
  redeemed_at text
  redeemed_by_user_id text
  created_at text [not null]

  Indexes {
    team_id [name: 'team_invites_team_idx']
  }
}

Table notification_channels {
  id text [pk]
  team_id text [not null]
  type text [not null, note: 'TS-only enum: telegram|slack|feishu']
  name text [not null]
  config jsonb [not null, note: 'ChannelConfig; secrets never sent to client raw']
  created_at text [not null]

  Indexes {
    team_id [name: 'notification_channels_team_idx']
  }
}

Table blobs {
  hash text [pk, note: 'sha256 hex of bytes; also the R2 object key']
  size integer [not null]
  binary boolean [not null, default: false, note: 'heuristic: bytes contain NUL']
  meta jsonb [note: 'ArtifactMeta {type?,title?,date?} parsed once at ingress; null for binary/untyped']
  created_at text [not null]
}

Table artifact_files {
  id text [pk]
  loop_id text [not null, note: 'logical -> loops.id']
  path text [not null, note: 'normalized, loop-folder-relative']
  hash text [note: 'logical -> blobs.hash; null when deleted or oversize']
  size integer
  binary boolean [not null, default: false]
  oversize boolean [not null, default: false, note: 'over 10MB per-file cap, metadata-only']
  deleted boolean [not null, default: false, note: 'tombstone']
  updated_at text [not null]
  last_run_id text [note: 'run in-flight when change synced; null for idle human edits']

  Indexes {
    loop_id [name: 'artifact_files_loop_idx']
    (loop_id, path) [unique, name: 'artifact_files_loop_path_idx']
    hash [name: 'artifact_files_hash_idx']
  }
}

Table run_snapshots {
  run_id text [pk, note: 'one row per run']
  loop_id text [not null]
  manifest jsonb [not null, note: 'SnapshotManifest: path -> {hash,size,binary,oversize}']
  created_at text [not null]

  Indexes {
    loop_id [name: 'run_snapshots_loop_idx']
  }
}

// ---- Better Auth tables (auth-schema.ts; accurate, summarized) ----

Table user {
  id text [pk]
  name text [not null]
  email text [not null, unique, note: 'CONSTRAINT user_email_unique']
  email_verified boolean [not null, default: false]
  image text
  created_at timestamp [not null, default: 'now()']
  updated_at timestamp [not null, default: 'now()']
}

Table session {
  id text [pk]
  expires_at timestamp [not null]
  token text [not null, unique, note: 'CONSTRAINT session_token_unique']
  created_at timestamp [not null, default: 'now()']
  updated_at timestamp [not null]
  ip_address text
  user_agent text
  user_id text [not null, ref: > user.id, note: 'ON DELETE CASCADE (enforced)']

  Indexes {
    user_id [name: 'session_userId_idx']
  }
}

Table account {
  id text [pk]
  account_id text [not null]
  provider_id text [not null]
  user_id text [not null, ref: > user.id, note: 'ON DELETE CASCADE (enforced)']
  access_token text
  refresh_token text
  id_token text
  access_token_expires_at timestamp
  refresh_token_expires_at timestamp
  scope text
  password text
  created_at timestamp [not null, default: 'now()']
  updated_at timestamp [not null]

  Indexes {
    user_id [name: 'account_userId_idx']
  }
}

Table verification {
  id text [pk]
  identifier text [not null]
  value text [not null]
  expires_at timestamp [not null]
  created_at timestamp [not null, default: 'now()']
  updated_at timestamp [not null, default: 'now()']

  Indexes {
    identifier [name: 'verification_identifier_idx']
  }
}

// ---- Relationships ----
// Enforced DB-level FKs (declared in DDL):
Ref enforced_session_user: session.user_id > user.id [delete: cascade]
Ref enforced_account_user: account.user_id > user.id [delete: cascade]

// Logical (application-enforced, NO DDL constraint) refs:
Ref logical_loops_machine: loops.machine_id > machines.id
Ref logical_loops_channel: loops.channel_id > notification_channels.id
Ref logical_runs_loop: runs.loop_id > loops.id
Ref logical_runs_machine: runs.machine_id > machines.id
Ref logical_lease_run: run_leases.run_id > runs.id
Ref logical_lease_loop: run_leases.loop_id > loops.id
Ref logical_artifact_loop: artifact_files.loop_id > loops.id
Ref logical_artifact_blob: artifact_files.hash > blobs.hash
Ref logical_snapshot_run: run_snapshots.run_id > runs.id
Ref logical_snapshot_loop: run_snapshots.loop_id > loops.id
Ref logical_members_team: team_members.team_id > teams.id
Ref logical_invites_team: team_invites.team_id > teams.id
Ref logical_channels_team: notification_channels.team_id > teams.id
